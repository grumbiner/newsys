#!/bin/sh

# t1  other=/Volumes/Transporter1/transfer/
other=/Volumes/Mac_Transport/transfer/
cd ~ 
if [ ! -d $other ] ; then
  echo could not find $other
  exit 1
fi

if [ $# -eq 1 ] ; then
  if [ $1 == "real" ] ; then
    echo really copying, ctl-C to flee
    sleep 15
  fi
fi

for odir in bin ENIAC website writing rg_nonncep usr2local cv archive active avlibrary
do
  x=`topdirs -m $odir`
  echo $x Mb in dir $odir

  if [ $# -eq 0 ] ; then
    rsync -n -rHptv --delete --exclude=.git $odir/ ${other}/$odir/
  else
    if [ $1 == "real" ] ; then
      rsync -rHptv --delete --exclude=.git $odir/ ${other}/$odir/
    else
      rsync -n -rHptv --delete --exclude=.git $odir/ ${other}/$odir/
    fi
  fi

done

find bin ENIAC writing active rg_nonncep website archive usr2local cv avlibrary \
 -type l | cpio -oav -O links.cpio

if [ $1 = "real" ] ; then
  cp links.cpio $other
fi
